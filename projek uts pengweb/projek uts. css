{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f8f4ed;
    color: #493b30;
    background-size: cover;
}

/* Bagian Header */
.header {
    min-height: 200px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 30px 10%;

    background-image:
        linear-gradient(
            rgba(248, 244, 237, 0.85),
            rgba(232, 220, 203, 0.85)
        ),
        url("images/background\ ungu.jpg");

    background-size: contain;
    background-position: center;
    background-size: cover;
}

/* Bagian tulisan */
.header-text {
    width: 55%;
}

.tagline {
    color: #a17b50;
    font-size: 13px;
    letter-spacing: 3px;
    margin-bottom: 20px;
}

.header-text h1 {
    font-family: Georgia, serif;
    font-size: 85px;
    letter-spacing: 8px;
    margin-bottom: 10px;
}

.header-text h2 {
    font-family: Georgia, serif;
    font-size: 25px;
    font-weight: normal;
    margin-bottom: 20px;
}

.description {
    font-size: 15px;
    line-height: 1.8;
    color: #7f7063;
    max-width: 450px;
    margin-bottom: 30px;
}

/* Tombol */
.btn {
    display: inline-block;
    background-color: #a17b50;
    color: white;

    padding: 13px 25px;
    text-decoration: none;

    font-size: 14px;
    border-radius: 3px;
}

.btn:hover {
    background-color: #524337;
}

/*navigasi menu*/
.navbar {
    background-color: #3b1408;
    padding: 20px;
}

.nav-menu {
    display: flex;
    justify-content: center;
    gap: 40px;
    list-style: none;
    margin: 0;
    padding: 0;
}

.nav-menu a {
    color: white;
    text-decoration: none;
    font-size: 16px;
}

.nav-menu a:hover {
    color: #d6b88a;
}

/* Pengenalan LAVERA */
.home-about {
    background-color: #f8f3eb;
    padding: 40px 10%;
    text-align: center;
    color: #49382d;
}

.home-about h2 {
    color: #3b1408;
    font-size: 28px;
}

.home-about p {
    line-height: 1.7;
}

/* RESPONSIVE */
@media screen and (max-width: 768px) {

    .navbar {
        flex-direction: column;
        gap: 20px;
    }

    .nav-menu {
        flex-wrap: wrap;
        justify-content: center;
        gap: 18px;
    }

}

/*best seller woman*/
.best-woman {
background-image:
        linear-gradient(
            rgba(248, 244, 237, 0.85),
            rgba(232, 220, 203, 0.85)
        ),
        url("images/background\ ungu.jpg");

    background-size: contain;
    background-position: center;
    background-size: cover;
 
       
}

.best-woman h2 {
    font-family:'Times New Roman', Times, serif;
    font-size: 30px;
    color: #391207;
    margin-bottom: 10px;
    text-align: center;
}

.subjudul {
    color: #352b0b;
    margin-bottom: 35px;
    text-align: center;
}

.produk-container {
     display: flex;
    justify-content: space-evenly;
    gap: 20px;
}

.produk {
    width: 225px;
     box-sizing: border-box;
    background-color: #3b1408;
    padding: 15px;
    text-align: center;
    border-radius: 30px;
}


.produk img {
   width: 100%;
    height: 180px;
    object-fit: cover;
   
}

.produk h3 {
    color: #49382d;
    margin: 12px 0 8px;
}

.produk p {
    font-size: 14px;
    color: #79695b;
}

.produk .harga {
    color: #9b7045;
    font-weight: bold;
    margin-top: 10px;
}

/*best seller man*/
.best-man {
   background-image:
        linear-gradient(
            rgba(248, 244, 237, 0.85),
            rgba(232, 220, 203, 0.85)
        ),
        url("images/background\ ungu.jpg");

    background-size: contain;
    background-position: center;
    background-size: cover;
 
      
}

.best-man h2 {
    font-family:'Times New Roman', Times, serif;
    font-size: 30px;
    color: #391207;
    margin-bottom: 10px;
    text-align: center;
}

.man-container {
    display: flex;
    justify-content: space-evenly;
    gap: 35px;
    margin-top: 35px;
}

.produk-man {
    width: 225px;
    box-sizing: border-box;
    background-color: #3b1408;
    padding: 15px;
    text-align: center;
    border-radius: 30px;
}

.produk-man img {
    width: 100%;
    height: 180px;
    object-fit: contain;
}

.produk-man h3 {
    color: #49382d;
    margin: 12px 0;
}

.produk-man p {
    color: #a99580;
    font-size: 14px;
}

.produk-man .harga {
    color: #b89a68;
    font-weight: bold;
    margin-top: 12px;
}

/*woman and Man collection*/
.judul-collection {
    background-color: #3b1408;
    color: white;
    padding: 20px;
    font-size: 25px;
    text-align: center;
    margin-bottom: 15px;
}
.woman-collection {
    background-image:
        linear-gradient(
            rgba(248, 244, 237, 0.85),
            rgba(232, 220, 203, 0.85)
        ),
        url("images/background\ ungu.jpg");

    background-color: #f8f3eb;
    padding: 40px 8%;
    text-align: center;
    background-size: cover;
    background-size: cover;
    
}

.man-collection {
     background-image:
        linear-gradient(
            rgba(248, 244, 237, 0.85),
            rgba(232, 220, 203, 0.85)
        ),
        url("images/background\ ungu.jpg");
    background-color: #e8dccb;
    padding: 40px 8%;
    text-align: center;
    background-size: cover;
}

.woman-collection h2,
.man-collection h2 {
    font-size: 30px;
    color: #993d21;
    margin-bottom: 10px;
}

.collection-container {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 25px;
    margin-top: 35px;
}

.collection-card {
    background-color: #3b1408;
    padding: 15px;
    box-sizing: border-box;
    text-align: center;
    border-radius: 15px;
}

.collection-card img {
    width: 100%;
    height: 180px;
    object-fit: contain;
}

.collection-card h3 {
    color: #49382d;
    margin: 12px 0;
}

.collection-card p {
    color: #a99580;
    font-size: 14px;
}

.collection-card .harga {
    color: #b89a68;
    font-weight: bold;
    margin-top: 12px;
}

/*about*/
.about-header {
    background-color: #e8dccb;
    text-align: center;
    padding: 60px 20px;
}

.about-header h1 {
    font-family: Georgia, serif;
    font-size: 38px;
    color: #493b30;
    letter-spacing: 4px;
    margin-bottom: 10px;
}

.about-header p {
    color: #776657;
    font-size: 15px;
}


/* OUR STORY */

.our-story {
    display: flex;
    align-items: center;
    gap: 50px;
    padding: 70px 10%;
    background-color: #f8f4ed;
}

.story-image {
    width: 45%;
}

.story-image img {
    width: 100%;
    height: 350px;
    object-fit: cover;
}

.story-text {
    width: 55%;
}

.story-text h2 {
    font-family: Georgia, serif;
    font-size: 30px;
    color: #493b30;
    margin-bottom: 20px;
}

.story-text p {
    color: #665548;
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 15px;
    text-align: justify;
}


/* VISION AND MISSION */

.vision-mission {
    background-color: #e8dccb;
    padding: 60px 10%;
    text-align: center;
}

.vision-mission h2 {
    font-family: Georgia, serif;
    color: #493b30;
    font-size: 30px;
    margin-bottom: 40px;
}

.vm-container {
    display: flex;
    justify-content: center;
    gap: 30px;
}

.vm-box {
    background-color: #f8f4ed;
    width: 50%;
    padding: 35px;
    text-align: left;
    border: 1px solid #d4c1a9;
}

.vm-box h3 {
    color: #a17b50;
    font-family: Georgia, serif;
    font-size: 23px;
    margin-bottom: 20px;
}

.vm-box p {
    color: #665548;
    font-size: 15px;
    line-height: 1.8;
}

/*registrasi*/
.registration-page {
    background-image:  
        linear-gradient(
            rgba(248, 244, 237, 0.85),
            rgba(232, 220, 203, 0.85)
        ),
        url("images/background\ ungu.jpg");
    padding: 60px 8%;
    display: flex;
    justify-content: center;
    background-size: cover;                                                                                                                     v                                             
}

.registration-box h1 {
    text-align: center;
    font-family: Georgia, serif;
    font-size: 36px;
    color: #493b30;
    letter-spacing: 3px;
}



.regis-subtitle {
    text-align: center;
    color: #776657;
    margin-bottom: 35px;
}

.registration-box form {
    display: flex;
    flex-direction: column;
}

.form-title {
    font-family: Georgia, serif;
    font-size: 23px;
    color: #493b30;
    border-bottom: 1px solid #c5b29c;
    padding-bottom: 12px;
    margin-top: 25px;
    margin-bottom: 20px;
}

.registration-box form > label {
    margin-bottom: 8px;
    color: #493b30;
}

.registration-box input,
.registration-box select,
.registration-box textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 14px;
    margin-bottom: 20px;
    border: 1px solid #c5b29c;
    background-color: #f8f4ed;
    font-size: 15px;
}

.order-section {
    margin-top: 20px;
}

.order-description {
    color: #776657;
    margin-bottom: 25px;
}

.regis-check {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 15px 0 20px;
}

.regis-check input {
    width: auto;
    margin: 0;
}

.regis-check label {
    margin: 0;
}

.registration-box button {
    width: 100%;
    padding: 16px;
    background-color: #493b30;
    color: white;
    border: none;
    font-size: 15px;
    letter-spacing: 2px;
    cursor: pointer;
}

.registration-box button:hover {
    background-color: #80644e;
}

@media screen and (max-width: 768px) {
    .registration-box {
        width: 100%;
        padding: 30px 20px;
    }
}
/*footer*/
.footer {
    background-color: #493b30;
    color: #f8f4ed;
    padding: 50px 8% 20px;
}

.footer-container {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
}

.footer-content {
    flex: 1;
    min-width: 180px;
}

.footer-content h2 {
    font-family: Georgia, serif;
    font-size: 30px;
    letter-spacing: 3px;
    margin-bottom: 15px;
}

.footer-content h3 {
    font-family: Georgia, serif;
    font-size: 18px;
    margin-bottom: 18px;
    color: #d6b58c;
}

.footer-content p {
    font-size: 14px;
    line-height: 1.8;
    color: #e8dccb;
    margin-bottom: 10px;
}

.footer-content ul {
    list-style: none;
    padding: 0;
}

.footer-content ul li {
    margin-bottom: 12px;
}

.footer-content ul li a {
    text-decoration: none;
    color: #e8dccb;
    font-size: 14px;
}

.footer-content ul li a:hover {
    color: #d6b58c;
    text-decoration: underline;
}

.footer-bottom {
    border-top: 1px solid #806c5b;
    text-align: center;
    margin-top: 40px;
    padding-top: 20px;
}

.footer-bottom p {
    font-size: 13px;
    color: #e8dccb;
}


